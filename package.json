{
  "name": "minsky-monitor",
  "version": "1.0.0",
  "description": "Minsky Monitor — Enterprise Bubble Analysis Tool",
  "main": "main.js",
  "author": {
    "name": "SolaroTrade",
    "email": "tu@email.com"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.solarotrade.minsky-monitor",
    "productName": "Minsky Monitor",
    "copyright": "Copyright © 2026 SolaroTrade",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "SolaroTrade",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/installer-header.bmp",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Minsky Monitor",
      "license": "LICENSE.txt",
      "language": "3082"
    },
    "publish": {
      "provider": "github",
      "owner": "puenteprod06-bit",
      "repo": "Analisis-de-burbujas",
      "releaseType": "release"
    }
  }
}

